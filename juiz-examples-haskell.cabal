cabal-version:      3.0
name:               juiz-examples-haskell
version:            0.1.0.0
synopsis:           Haskell examples for juiz, written with hsjuiz
license:            MIT OR Apache-2.0
license-files:      LICENSE-MIT
                    LICENSE-APACHE
author:             ysuga
maintainer:         ysuga
homepage:           https://github.com/OpenJUIZ/juiz_examples_haskell
build-type:         Simple

-- juiz が読み込む共有ライブラリ (Linux は lib<名前>.so、macOS は lib<名前>.dylib、Windows は <名前>.dll) を
-- foreign-library で作る。ライブラリ名は設定ファイルに書く名前 (process_factories などのキー) と同じにする。
--
-- juiz は Process をワーカースレッドから呼ぶので -threaded の RTS が必要
-- (-threaded でなければ読み込みがエラーになる)。
-- libjuiz_sdk は build.sh が build/plugins に置き、--extra-lib-dirs で渡す。
-- Linux・macOS のプラグインには、自分と同じ場所から libjuiz_sdk を探す rpath を付ける
-- (Windows に rpath は無く、juiz はプラグインの隣の juiz_sdk.dll を読み込む)。
--
-- Windows の GHC は Haskell の共有ライブラリを持たないので、foreign-library ごとに options: standalone で
-- RTS と hsjuiz を DLL に取り込み、公開する関数を def/<名前>.def に並べて mod-def-file で渡す
-- (common に書いても cabal は受け付けない。juiz の bindings/hsjuiz/README.md の「Windows」)。
-- また Windows では -fno-PIC を付ける。-fPIC のジャンプテーブルが壊れ、構成子が 7 個以上の型の case や show が
-- 落ちるため (juiz の issue #262、GHC の不具合 https://gitlab.haskell.org/ghc/ghc/-/issues/24016)。

common plugin
    default-language: Haskell2010
    build-depends:    base >=4.18 && <5
                    , hsjuiz
    ghc-options:      -Wall -threaded
    if os(darwin)
        ghc-options:  -optl-Wl,-rpath,@loader_path
    elif os(windows)
        ghc-options:  -fno-PIC
    else
        ghc-options:  -optl-Wl,-rpath,$ORIGIN

-- Process
foreign-library increment_process_hs
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/increment_process_hs.def
    hs-source-dirs:   process
    other-modules:    IncrementProcess

foreign-library decrement_process_hs
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/decrement_process_hs.def
    hs-source-dirs:   process
    other-modules:    DecrementProcess

foreign-library talker_hs
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/talker_hs.def
    hs-source-dirs:   process
    build-depends:    text
    other-modules:    Talker

foreign-library listener_hs
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/listener_hs.def
    hs-source-dirs:   process
    build-depends:    text
    other-modules:    Listener

-- 型付きの Process。build/gen-hs の Examples.Geometry は build.sh が types/geometry.jidl から juiz-idl -g haskell で作る
foreign-library pose_move_hs
    import:           plugin
    type:             native-shared
    if os(windows)
        options:      standalone
        mod-def-file: def/pose_move_hs.def
    hs-source-dirs:   process build/gen-hs
    build-depends:    bytestring, containers, text
    other-modules:    PoseMove
                      Examples.Geometry

