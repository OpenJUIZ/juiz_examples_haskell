cabal-version:      3.0
name:               juiz-examples-haskell
version:            0.1.0.0
synopsis:           Haskell examples for juiz, written with hsjuiz
license:            MIT OR Apache-2.0
license-files:      LICENSE-MIT
                    LICENSE-APACHE
author:             ysuga
maintainer:         ysuga
homepage:           https://github.com/OpenJUIZ/juiz_examples_haskell
build-type:         Simple

-- juiz が読み込む共有ライブラリ (Linux は lib<名前>.so、macOS は lib<名前>.dylib) を foreign-library で作る。
-- ライブラリ名は設定ファイルに書く名前 (process_factories などのキー) と同じにする。
--
-- juiz は Process をワーカースレッドから呼ぶので -threaded の RTS が必要
-- (-threaded でなければ読み込みがエラーになる)。
-- libjuiz_sdk は build.sh が build/plugins に置き、--extra-lib-dirs で渡す。
-- プラグインには自分と同じ場所から libjuiz_sdk を探す rpath を付ける。

common plugin
    default-language: Haskell2010
    build-depends:    base >=4.17 && <5
                    , hsjuiz
    ghc-options:      -Wall -threaded
    if os(darwin)
        ghc-options:  -optl-Wl,-rpath,@loader_path
    else
        ghc-options:  -optl-Wl,-rpath,$ORIGIN

-- Process
foreign-library increment_process_hs
    import:           plugin
    type:             native-shared
    hs-source-dirs:   process
    other-modules:    IncrementProcess

foreign-library decrement_process_hs
    import:           plugin
    type:             native-shared
    hs-source-dirs:   process
    other-modules:    DecrementProcess

foreign-library talker_hs
    import:           plugin
    type:             native-shared
    hs-source-dirs:   process
    build-depends:    text
    other-modules:    Talker

foreign-library listener_hs
    import:           plugin
    type:             native-shared
    hs-source-dirs:   process
    build-depends:    text
    other-modules:    Listener

-- 型付きの Process。build/gen-hs の Examples.Geometry は build.sh が types/geometry.jidl から juiz-idl -g haskell で作る
foreign-library pose_move_hs
    import:           plugin
    type:             native-shared
    hs-source-dirs:   process build/gen-hs
    build-depends:    bytestring, containers, text
    other-modules:    PoseMove
                      Examples.Geometry

-- Container と ContainerProcess は別々のライブラリになる。状態の型 (ExampleContainerState) はどちらにも入れる
foreign-library example_container_hs
    import:           plugin
    type:             native-shared
    hs-source-dirs:   container
    other-modules:    ExampleContainer
                      ExampleContainerState

foreign-library example_container_hs_increment
    import:           plugin
    type:             native-shared
    hs-source-dirs:   container
    other-modules:    ExampleContainerIncrement
                      ExampleContainerState

foreign-library example_container_hs_get
    import:           plugin
    type:             native-shared
    hs-source-dirs:   container
    other-modules:    ExampleContainerGet
                      ExampleContainerState

-- Component: 1 つのライブラリに Process・Container・ContainerProcess をまとめる
foreign-library example_component_hs
    import:           plugin
    type:             native-shared
    hs-source-dirs:   component
    other-modules:    ExampleComponent
