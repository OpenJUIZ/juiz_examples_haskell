    increment_factory_entry_point
    createContainer_manifest_entry_point
    createContainer_factory_entry_point
    createContainer_factory_destroy_entry_point
    containerGet_manifest_entry_point
    containerGet_factory_entry_point
    containerIncrement_manifest_entry_point
    containerIncrement_factory_entry_point
